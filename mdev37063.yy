query:
  SELECT tb1.`veccol` FROM vector_db.`deep_image_10K` tb1 WHERE tb1.veccol LIKE CONCAT(0x30303030,'%') AND tb1.veccol NOT LIKE CONCAT(0x30303030,'%') AND VEC_DISTANCE(veccol, veccol) = 0x1D8ADFF037 OR VEC_TOTEXT(tb1.veccol) NOT LIKE '[%]' AND VEC_FROMTEXT(VEC_TOTEXT(tb1.veccol)) LIKE CONCAT(0x30303030,'%') ORDER BY VEC_DISTANCE_EUCLIDEAN(tb1.veccol, VEC_FROMTEXT('[26.410,25.237,10.569,32.251,26.908,5.346,26.338,22.668,-0.750,27.490,12.949,33.062,19.634,7.523,26.505,18.123,14.733,3.583,29.605,32.207,7.877,10.386,24.121,18.464,19.019,23.922,29.727,23.593,2.994,10.537,18.159,16.145,0.758,17.712,26.164,10.432,21.587,31.161,4.929,5.756,13.743,15.855,9.573,19.326,2.161,20.131,26.683,3.989,10.626,16.450,28.096,23.904,-0.964,3.088,6.993,5.238,7.100,21.060,27.192,13.648,19.793,9.948,32.204,-1.993,27.547,16.623,8.689,17.049,32.201,-1.192,1.350,0.133,15.813,-0.725,6.749,25.369,9.328,19.453,-1.952,17.305,16.616,4.321,19.140,32.082,-0.606,9.402,13.174,33.412,12.006,25.211,-0.934,11.427,19.945,30.917,26.563,26.992]')) ASC LIMIT 69;
