# innodb-buffer-pool-size is scaled down
# default_password_lifetime=90 removed
# non-default paths (innodb data home dir, logs, etc.) removed

[mariadb]
binlog_annotate_row_events=OFF
binlog_cache_size=1048576
binlog_expire_logs_seconds=432000
binlog_format=ROW
binlog_stmt_cache_size=131072
character_set_server=utf8mb3
collation_server=utf8mb3_general_ci
disconnect_on_expired_password=ON
expire_logs_days=5.0
explicit_defaults_for_timestamp=ON
gtid_strict_mode=ON
host_cache_size=1103
ignore_db_dirs=lost+found
innodb_autoinc_lock_mode=2
innodb_buffer_pool_size=4G
innodb_flush_neighbors=0
innodb_io_capacity=400
innodb_io_capacity_max=4000
innodb_lock_wait_timeout=180
innodb_log_buffer_size=67108864
innodb_log_file_size=4294967296
innodb_max_dirty_pages_pct=50.0
innodb_open_files=2048
innodb_print_all_deadlocks=ON
innodb_read_io_threads=8
innodb_sort_buffer_size=12582912
innodb_write_io_threads=8
join_buffer_size=4194304
join_buffer_space_limit=4194304
join_cache_level=6
key_buffer_size=67108864
lock_wait_timeout=10800
log_bin=custom1-slave
log_bin_compress=ON
log_bin_trust_function_creators=ON
log_slave_updates=ON
log_slow_verbosity=innodb,query_plan
long_query_time=30
lower_case_table_names=1
master_verify_checksum=ON
max_allowed_packet=67108864
max_binlog_size=268435456
max_connect_errors=10000
max_connections=10000
max_heap_table_size=33554432
max_password_errors=5
max_relay_log_size=268435456
myisam_recover_options=BACKUP,FORCE
myisam_sort_buffer_size=67108864
open_files_limit=278528
optimizer_search_depth=0
optimizer_switch=index_merge=on,index_merge_union=on,index_merge_sort_union=on,index_merge_intersection=on,index_merge_sort_intersection=off,index_condition_pushdown=on,derived_merge=on,derived_with_keys=on,firstmatch=on,loosescan=on,materialization=on,in_to_exists=on,semijoin=on,partial_match_rowid_merge=on,partial_match_table_scan=on,subquery_cache=on,mrr=on,mrr_cost_based=on,mrr_sort_keys=off,outer_join_with_cache=on,semijoin_with_cache=on,join_cache_incremental=on,join_cache_hashed=on,join_cache_bka=on,optimize_join_buffer_size=on,table_elimination=on,extended_keys=on,exists_to_in=on,orderby_uses_equalities=on,condition_pushdown_for_derived=on,split_materialized=on,condition_pushdown_for_subquery=on,rowid_filter=on,condition_pushdown_from_having=on,not_null_range_scan=off,hash_join_cardinality=off,cset_narrowing=off,sargable_casefold=off
plugin_maturity=stable
proxy_protocol_networks=*
query_cache_size=0
read_only=ON
relay_log_recovery=ON
replicate_events_marked_for_skip=FILTER_ON_MASTER
rpl_semi_sync_master_enabled=ON
rpl_semi_sync_slave_enabled=ON
server_audit_file_rotate_now=OFF
server_audit_file_rotate_size=50000000
server_audit_file_rotations=100
server_audit_load_on_error=ON
server_audit_logging=ON
server_audit_mode=0
server_audit_output_type=file
server_audit_query_log_limit=1024
server_audit_reload_filters=OFF
server_audit_syslog_facility=LOG_USER
server_audit_syslog_ident=mysql-server_auditing
server_audit_syslog_info=
server_audit_syslog_priority=LOG_INFO
server_audit_timestamp_format=%Y%m%d %H:%i:%s
shutdown_wait_for_slaves=ON
simple_password_check_digits=1
simple_password_check_letters_same_case=1
simple_password_check_minimal_length=15
simple_password_check_other_characters=1
slave_net_timeout=10
slave_parallel_max_queued=67108864
slave_parallel_threads=4
slave_parallel_workers=4
slow_query_log=ON
sql_error_log_rate=1
sql_error_log_rotate=OFF
sql_error_log_rotations=9
sql_error_log_size_limit=268435456
sql_error_log_with_db_and_thread_info=OFF
sql_mode=PIPES_AS_CONCAT,ANSI_QUOTES,IGNORE_SPACE,ORACLE,NO_KEY_OPTIONS,NO_TABLE_OPTIONS,NO_FIELD_OPTIONS,STRICT_TRANS_TABLES,NO_AUTO_CREATE_USER,SIMULTANEOUS_ASSIGNMENT
sync_binlog=1
sync_master_info=1
table_definition_cache=16384
table_open_cache=16384
thread_cache_size=256
thread_pool_size=16
thread_stack=262144
tmp_memory_table_size=33554432
tmp_table_size=33554432
transaction_isolation=READ-COMMITTED
use_stat_tables=PREFERABLY
userstat=ON
wait_timeout=3600
plugin-load-add=server_audit2
plugin-load-add=simple_password_check
plugin-load-add=sql_errlog
